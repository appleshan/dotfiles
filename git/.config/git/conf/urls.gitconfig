# URL shorthands
[url "git@ssh.github.com:"]
    insteadOf = "gh:"
    insteadOf = "git@github.com:"   # 可选：强制所有 GitHub SSH 走 443
    pushInsteadOf = "github:"
    pushInsteadOf = "git://github.com/"

[url "git://github.com/"]
    insteadOf = "github:"

[url "git@gist.github.com:"]
    pushInsteadOf = "gist:"
    pushInsteadOf = "git://gist.github.com/"

[url "git://gist.github.com/"]
    insteadOf = "gist:"

[url "git@ssh.github.com:appleshan/"]
    insteadOf = "my:"

