# cURL configuration options
# http://curl.haxx.se/docs/manpage.html

# - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

# Limit the time (in seconds) the connection is allowed to take.
# Wait 60 seconds before timing out.
connect-timeout = 60

# Follow HTTP redirects
location

# Display progress as a simple progress bar
progress-bar

# Show error messages
show-error

# Disguise as IE 9 on Windows 7.
#user-agent = "Mozilla/5.0 (compatible; MSIE 9.0; Windows NT 6.1; Trident/5.0)"

# When following a redirect, automatically set the previous URL as referer.
referer = ";auto"

#proxy = http://127.0.0.1:20172

# curl 与 wget 不用配置 proxy 了，因为用了 v2raya 的透明代理，
# 检查网络是否 Online（连通）:
# curl -I http://google.com/generate_204
# 若返回 HTTP/1.1 204 No Content，则网络已通。
