#!/bin/sh

# @See https://rqdmap.top/posts/trash%E5%8F%96%E4%BB%A3%E5%8D%B1%E9%99%A9%E7%9A%84rm/

DEST="/home/`whoami`/.local/share/Trash/files/"

# No arguments...
if [ -z "$1" ]; then
	echo "trash: trash [FILE]..."
	exit -1;
fi


for file in "$@"; do
	filename=${file##*/}

	if [ ! -e $file -a ! -L $file ]; then
		echo -e "\033[31m[Error]\033[0m No such file or directory '$file'"
		continue
	fi

	if [ ! -e $DEST$filename -a ! -L $DEST$filename ]; then
		mv "$file" $DEST
		continue
	fi

	echo -ne "\033[35m[Warning]\033[0m File or directory '$DEST$filename' exists! Override? (y/n) "
	read answer
	if [ -z "$answer" -o "${answer:0:1}x" = 'yx' -o "${answer:0:1}" = 'Yx' ]; then
		rm -rf $DEST$filename
		mv "$file" $DEST
		echo -e "\033[32m[Success]\033[0m Removed $DEST$filename."
	fi
done
