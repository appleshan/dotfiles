# /etc/ssh/sshd_config
#SSH 基本加固

#SSH 服务监听的默认端口
Port 22122

#禁止 Root 用户直接登录，使用普通用户登录，使用 sudo 提权
PermitRootLogin no

#禁用 DNS 反查
UseDNS no

#禁用 X11 转发
X11Forwarding no

# {{ ssh密钥登录
#RSA认证
RSAAuthentication yes

#开启公钥验证
PubkeyAuthentication yes

#验证文件路径
AuthorizedKeysFile .ssh/authorized_keys

#禁止密码认证
PasswordAuthentication no

#禁止空密码
PermitEmptyPasswords no

# 重启SSH服务
# systemctl restart sshd
# }}
