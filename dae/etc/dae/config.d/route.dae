# /etc/dae/config.d/route.dae

# 分流规则分为两部分，左侧为匹配规则，右侧为匹配到规则后使用的节点分组，
# 规则按从上到下的顺序匹配；
# 内置的出站规则有 block, direct, must_direct, must_rules，
# (must_rules 表示不将DNS流量重定向至 dae 并继续匹配)，
# 除此之外必须使用 group 定义的节点分组，如 前面定义的 proxy, ai 等.

# 内置出站: block, direct, must_rules
# must_rules 表示不将DNS流量重定向至dae并继续匹配。
# 对于单条规则，"direct"和"must_direct"的区别在于"direct"会劫持并处理
# DNS 请求（用于流量分割使用），而"must_direct"不会。
# 当存在 DNS 请求的回环时，"must_direct"很有用。

# 路由规则，根据规则决定流量的处理策略，包括直连、分流代理到特定的分组或节点.
# 更多的 Routing 样例见 https://github.com/daeuniverse/dae/blob/main/docs/zh_CN/configuration/routing.md
routing {
  # 本地的网络管理器应该直连，以避免在绑定WAN接口的时候出现错误的网络连通性检查结果
  pname(NetworkManager) -> must_direct

  # 目标 IP 多播、广播地址，直连
  # 把它放在前面，可以防止多播应该发送到局域网的数据包被代理转发。
  dip(224.0.0.0/3, 'ff00::/8') -> direct

  ### Write your rules below.

  # 强制 PaopaoDns 发出的请求，按 DAE 的“路由”规则来匹配
  # (e.g. 223.5.5.5 匹配 "dip(geoip:cn) -> direct"，1.1.1.1 匹配 "fallback: proxy")
  # 原因：国外DNS (1.1.1.1、8.8.8.8) 的解析请求，通常会被国内运营商抢答，
  # 哪怕是 DoH、DoT 也会有阻断的情况，
  # 所以统一经由代理节点进行 DNS 解析为最佳方案.
  # 注意：不需要再写 pname(paopaodns) && l4proto(udp) && dport(1053) -> must_direct，冗余
  pname(paopaodns) -> must_rules

  # DNS 地址或域名，强制直连。
  # 原因：通常来讲，查询 Geo 是项耗时操作，此处直接明文确定 DNS IP 是否路由为
  # Proxy，可加快 DNS 解析速度。
  dip(223.5.5.5, 223.6.6.6) -> direct
  domain(full:dns.alidns.com) -> direct
  dip(119.29.29.29, 119.28.28.28) -> direct
  domain(full:doh.pub) -> direct
  dip(8.8.8.8, 8.8.4.4) -> proxy
  domain(full:dns.google) -> proxy
  dip(1.1.1.1, 1.0.0.1) -> proxy
  domain(full:one.one.one.one, full:cloudflare-dns.com) -> proxy

  # Block
  # 拦截UDP 443的QUIC流量，强制其回退到TCP，解决QUIC导致的卡顿与丢包等场景
  # 注意：会阻塞DoH3、DoQ方式的DNS解析，对策为显式配置DNS规则并置于该条规则上方
  l4proto(udp) && dport(443) -> block
  # 拦截IPv6流量(待确认，可能会影响Local IPv6)
  #ipversion(6) -> block
  domain(full:statsig.anthropic.com, suffix: wxs.qq.com) -> block
  # 广告域名，拒绝
  domain(geosite:category-ads) -> block
  domain(geosite:category-ads-all) -> block

  # Private
  # 原因：内网通信无需分流，强制直连即可
  # 注意：不可写为 must_direct，否则下游服务在DNS查询会直接跳过路由器的 DNS解析器 (DAE、MosDns)
  # e.g. 下游存在一台NAS，NAS中/etc/resolv.conf配置如下：
  # nameserver 127.0.0.1
  # nameserver 192.168.100.1
  # nameserver 114.114.114.114
  # nameserver 8.8.8.8
  # 若配置为 must_direct，则下游服务在请求 DNS 解析时，会跳过 192.168.100.1，
  # 而直接向 114.114.114.114、8.8.8.8 请求，无法被路由器管理
  dip(geoip:private) -> direct
  domain(geosite:private) -> direct

  # PS(Proxy Server)
  # 原因：假设没有下述规则的话，流程如下：
  # 浏览器请求网址(e.g. Google) → MosDns根据Geo识别为国外域名
  # → MosDns使用国外DNS(e.g. 1.1.1.1:853)查询 → DAE为1.1.1.1路由到proxy
  # → DAE连接代理节点时发现其Address为域名 → MosDns根据Geo识别Address为国外域名
  # → DAE为Address路由到proxy → ...
  # 最终，形成链路回环
  # 注意：极度重要！避免链路回环，强制直连代理节点中关联的域名(e.g. Address、SNI)
  domain(suffix:bbroot.com) -> direct
  domain(suffix:alans.qzz.io) -> direct
  domain(suffix:freesocks.org) -> direct
  domain(suffix:cmliussss.net) -> direct
  domain(suffix:ufw.kdns.fr) -> direct

  # Direct
  # 好友列表的状态更新
  domain(suffix:cm.steampowered.com) -> direct
  # 影响IPCountry，e.g. “钱包”中货币切换，以及下载时是否走本地CDN
  domain(suffix:steamserver.net) -> direct

  domain(full:blog.cloudflare.com) -> direct
  domain(full:dash.cloudflare.com) -> direct
  domain(full:cdn.jsdelivr.net) -> direct

  domain(suffix:alans.site) -> direct
  domain(suffix:binance.com) -> direct
  domain(suffix:bnw3w.com) -> direct
  domain(suffix:okx.com) -> direct
  domain(suffix:okx.cab) -> direct
  domain(suffix:okx.ac) -> direct
  domain(suffix:okx-doh.com) -> direct
  domain(suffix:okx-httpdns.com) -> direct
  domain(suffix:okex.org) -> direct
  domain(suffix:wetab.link) -> direct
  domain(suffix:adblockplus.org) -> direct
  domain(suffix:proxy-socks5.com) -> direct

  domain(geosite:steam@cn) -> direct
  domain(geosite:category-games@cn) -> direct
  domain(geosite:microsoft@cn) -> direct
  domain(geosite:apple@cn) -> direct
  domain(geosite:paypal) -> direct  ## PayPal
  domain(geosite:tencent) -> direct  ## WX DOMAIN

  dip(geoip:cn) -> direct
  domain(geosite:cn) -> direct

  # 内网网段直连/私有地址使用must规则
  l4proto(udp) && dport(53) -> must_direct
  l4proto(udp) && dport(1053) -> must_direct
  dip(192.168.3.0/24) -> must_direct

  ## Netflix/Telegram/Github/Docker/non-CN
  dip(geoip:netflix) -> proxy
  dip(geoip:telegram) -> proxy
  domain(geosite:netflix) -> proxy
  domain(geosite:github) -> proxy
  domain(geosite:docker) -> proxy
  domain(geosite:category-public-tracker) -> proxy
  domain(geosite:category-cdn-!cn) -> proxy
  domain(geosite:geolocation-!cn) -> proxy

  ## 国内AI类应用
  domain(geosite:category-ai-cn)  -> direct

  ## 海外AI类应用
  domain(geosite:category-ai-!cn) -> ai

  # AI 域名，AI 分组代理
  domain(suffix: claude.ai) -> ai
  domain(suffix: openai.com) -> ai

  domain(full:missav.ai) -> av
  domain(full:missav.ws) -> av
  domain(full:missav123.com) -> av
  domain(full:fourhoi.com) -> av
  domain(full:go.mayzaent.com) -> av
  domain(full:cdn.tsyndicate.com) -> av
  domain(full:creative.myavlive.com) -> av
  domain(full:client-rapi-missav.recombee.com) -> av

  domain(full:t66y.com) -> av
  domain(full:hyaa20.com) -> av
  domain(full:66img.cc) -> av
  domain(full:static.redircdn.com) -> av

  ### fallback 出站
  # 未匹配上面的规则时使用的默认出站.
  fallback: proxy
}
