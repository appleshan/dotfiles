# /etc/dae/config.d/dns.dae

# DNS配置，包括上游 DNS 服务器、DNS 分流策略等.
# 请参阅 https://github.com/daeuniverse/dae/blob/main/docs/en/configuration/dns.md 获取完整示例。
dns {
  # 这里的 dns 配置，不在乎极致速度，而是更注重隐私和 DNS 泄露

  # 首选 IP 协议版本，若为 4，域名有 A 和 AAAA 记录时仅响应 A 记录，AAAA 返回空
  ipversion_prefer: 4

  # 绑定到本地地址以监听 DNS 查询请求
  bind: '127.0.0.1:1153'

  # 上游 DNS 服务器，支持多种协议（udp/tcp/http3/h3/https/tls 等）.
  upstream {
    # 值可以是 scheme://host:port，其中 scheme 可以是 tcp/udp/tcp+udp/h3/http3/quic/https/tls。
    # 如果协议是 h3/http3/https，它支持设置自定义路径，即格式可以是"protocol://host:port/custom path"。
    # 如果主机是域名并且具有 IPv4 和 IPv6 记录，dae 将根据组策略（例如最小延迟策略）自动选择
    # IPv4 或 IPv6 使用。
    # 请确保 DNS 流量将通过并由 dae 转发，这对于域名路由是必需的。
    # 如果 dial_mode 是"ip"，上游 DNS 回答不应被污染，因此不建议使用国内公共 DNS。

    # 阿里云 DNS，用于国内域名查询
    alidns: 'udp://223.5.5.5:53'
    # Cloudflare DNS，用于非国内的 DNS 查询
    cfdns: 'tcp+udp://1.1.1.1:53'
    # 本地 DNS，用于内网自定义的  DNS 查询
    paopaodns: 'tcp+udp://127.0.0.1:1053'
  }

  # DNS 查询规则
  routing {
    # 根据 DNS 查询，决定使用哪个 DNS 上游，按由上到下的顺序匹配。
    request {
      # 禁用IPv6，可屏蔽AAAA相关日志的打印
      qtype(aaaa) -> reject
      # 禁用ECH，避免影响分流
      qtype(https) -> reject
      # 广告拒绝
      qname(geosite:category-ads-all) -> reject

      # 指定 DNS 查询规则，如对中国域名使用 alidns，其余使用 paopaodns.

      # node的所有域名要走直连解析，直接fallback给谷歌会死循环
      qname(full:nodes.full.domain) -> cfdns

      # 国内域名使用阿里云
      qname(geosite:cn) -> alidns

      # fallback 默认兜底 DNS
      fallback: paopaodns
    }
  }
}
