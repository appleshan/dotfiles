# ~/.ssh/config
# @See https://lab.jinkan.org/2020/03/03/using-ed25519-keys-in-ssh/

# 关于别名
# Host 是别名，HostName 是真正的域名。
# 得益于别名，你可以直接以别名访问地址。例如：
# 无别名： git clone git@github.com:torvalds/linux.git
# 有别名： git clone github:torvalds/linux.git

# 关于代理
# SOCKS 代理格式： ProxyCommand connect -S localhost:1080  %h %p
# HTTP 代理格式： ProxyCommand connect -H localhost:1080  %h %p

Host *
  # https://blogs.perl.org/users/smylers/2011/08/ssh-productivity-tips.html
  # Enable connection sharing.
  ControlMaster auto
  ControlPath /tmp/ssh-socks-%r@%h:%p
  # Make persistent connections that can be reused.
  ControlPersist 4h
  # Keep connections alive (helps TRAMP to detect disconnects.)
  KeepAlive yes
  ServerAliveInterval 5
  Compression yes

  #关闭 ssh 的 gssapi 认证
  GSSAPIAuthentication no
  GSSAPIDelegateCredentials no

Include ~/.ssh/ssh_host/config

#Default Git
# https://github.com/appleshan/
Host github.com
  HostName ssh.github.com
  User Alan.Shan
  IdentityFile ~/.ssh/id_rsa_github
  IdentitiesOnly yes
  TCPKeepAlive yes
  # 走 socks5 代理（直接使用 v2raya 提供的 socks5 代理端口）
  ProxyCommand nc -v -X 5 -x 127.0.0.1:20170 %h %p

#Second Git
Host bitbucket.org
  HostName bitbucket.org
  User Alan.Shan
  IdentityFile ~/.ssh/id_rsa_bitbucket
  IdentitiesOnly yes

# https://github.com/appleshan/docker-ssh/blob/master/README.md
# Allows connecting to all your local docker containers using ssh simply like this:
# ssh container-name.docker -p 2222
Host *.docker
  User linuxserver
  ProxyCommand ~/.ssh/docker-proxy %h %p
