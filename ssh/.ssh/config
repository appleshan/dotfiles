# ~/.ssh/config

Host *
  # https://blogs.perl.org/users/smylers/2011/08/ssh-productivity-tips.html
  # Enable connection sharing.
  ControlMaster auto
  ControlPath /tmp/ssh-socks-%r@%h:%p
  # Make persistent connections that can be reused.
  ControlPersist 4h
  # Keep connections alive (helps TRAMP to detect disconnects.)
  KeepAlive yes
  ServerAliveInterval 5
  Compression yes

  #关闭 ssh 的 gssapi 认证
  GSSAPIAuthentication no
  GSSAPIDelegateCredentials no

#Default Git
# https://github.com/appleshan/
Host github.com
  HostName ssh.github.com
  User appleshan
  IdentityFile ~/.ssh/id_rsa_github
  TCPKeepAlive yes
  # 走 HTTP 代理， Arch Linux 先 `pacman -S socat`
  #ProxyCommand socat - PROXY:127.0.0.1:%h:%p,proxyport=20171
  # 走 socks5 代理（如 v2rayA），Arch Linux 先 `pacman -S openbsd-netcat`
  ProxyCommand nc -v -x 127.0.0.1:20170 %h %p

#Second Git
Host bitbucket.org
  HostName bitbucket.org
  User appleshan
  IdentityFile ~/.ssh/bitbucket

# https://github.com/appleshan/docker-ssh/blob/master/README.md
# Allows connecting to all your local docker containers using ssh simply like this:
# ssh container-name.docker -p 2222
Host *.docker
  User linuxserver
  ProxyCommand ~/.ssh/docker-proxy %h %p
